# Environment Variables for British Auction RFQ System

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=british_auction
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
FRONTEND_PORT=5174
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/british_auction
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5435/british_auction

# Backend Configuration
SECRET_KEY=british_auction_super_secret_jwt_key_for_demo_purposes_only_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5174","http://localhost:5173","http://localhost:3000","http://localhost"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
